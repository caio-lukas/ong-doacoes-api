# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo .env contém segredos e NUNCA deve ser commitado (está no .gitignore).

# ----- Banco de dados -----
DB_NAME=ong_doacoes
DB_USER=ong
DB_PASSWORD=troque-esta-senha

# ----- JWT -----
# Chave de assinatura dos tokens: no mínimo 32 caracteres, aleatória.
# Para gerar uma: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres

# ----- Primeiro administrador -----
# Criado na inicialização, se ainda não existir nenhum admin ativo.
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-esta-senha-do-admin
